{
  "name": "uikey",
  "displayName": "UIKey",
  "description": "Apply UIKey styles directly in VSCode",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "uikey.applyStyle",
        "title": "Apply UIKey"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/node": "^26.6.4"
  }
}
